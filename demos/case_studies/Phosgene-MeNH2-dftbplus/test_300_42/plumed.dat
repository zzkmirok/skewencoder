# vim:ft=plumed
UNITS LENGTH=A TIME=0.001  #Amstroeng, hartree, fs


C1C5: DISTANCE ATOMS=1,5
Cl2Cl3: DISTANCE ATOMS=2,3
C1Cl2: DISTANCE ATOMS=1,2
C1Cl3: DISTANCE ATOMS=1,3
C5Cl2: DISTANCE ATOMS=5,2
C5Cl3: DISTANCE ATOMS=5,3
C1O4: DISTANCE ATOMS=1,4
C5O4: DISTANCE ATOMS=5,4
C1N9: DISTANCE ATOMS=1,9
C5N9: DISTANCE ATOMS=5,9
Cl2O4: DISTANCE ATOMS=2,4
Cl3O4: DISTANCE ATOMS=3,4
Cl2N9: DISTANCE ATOMS=2,9
Cl3N9: DISTANCE ATOMS=3,9
O4N9: DISTANCE ATOMS=4,9


LOAD FILE=/rwthfs/rz/cluster/hpcwork/noco0020/ZZh/chemtrayzer-zzk/lib/python3.13/site-packages/pycv/PythonCVInterface.so
vdw_contact: PYCVINTERFACE ATOMS=1-11 IMPORT=skewencoder.contactwall INIT=plumedInit CALCULATE=plumedCalculate
vdw_wall: UPPER_WALLS ARG=vdw_contact.py-gap AT=0.0 KAPPA=250 EXP=2.0 EPS=1.0 OFFSET=0.0


cv_heavy: PYTORCH_MODEL FILE=./results/iter_1/model_autoencoder_1.pt ARG=C1C5,Cl2Cl3,C1Cl2,C1Cl3,C5Cl2,C5Cl3,C1O4,C5O4,C1N9,C5N9,Cl2O4,Cl3O4,Cl2N9,Cl3N9,O4N9


cv_wall_heavy: UPPER_WALLS ARG=cv_heavy.node-0 AT=-0.520548403263092 KAPPA=300.0 EXP=2.0 EPS=1.0 OFFSET=0.0


PRINT FMT=%g STRIDE=10 FILE=./results/iter_1/COLVAR ARG=C1C5,Cl2Cl3,C1Cl2,C1Cl3,C5Cl2,C5Cl3,C1O4,C5O4,C1N9,C5N9,Cl2O4,Cl3O4,Cl2N9,Cl3N9,O4N9,vdw_contact.py-gap,vdw_contact.py-nfrag,vdw_wall.bias,cv_heavy.*
