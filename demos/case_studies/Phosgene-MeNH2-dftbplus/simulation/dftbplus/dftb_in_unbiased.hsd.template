# Unbiased segment: starts from the system geometry, velocities drawn at <TEMPERATURE> K
Geometry = GenFormat {
  <<< "<GEOMETRY_FILE>"
}

Driver = VelocityVerlet {
  MovedAtoms = 1:-1
  Steps = <N_STEPS>
  TimeStep [fs] = <TIMESTEP>
  Thermostat = NoseHoover {
    Temperature [Kelvin] = <TEMPERATURE>
    CouplingStrength [cm^-1] = <COUPLING_STRENGTH>
  }
  MDRestartFrequency = <PRINT_STRIDE>
  OutputPrefix = "geo_end"
  Plumed = Yes
}

Hamiltonian = xTB {
  Method = "GFN2-xTB"
  Charge = <CHARGE>
  SCCTolerance = 1e-6
  MaxSCCIterations = 200
  Filling = Fermi {
    Temperature [Kelvin] = <ELECTRONIC_TEMPERATURE>
  }
  KPointsAndWeights = {
    0.0 0.0 0.0 1.0
  }
}

Options {
  RandomSeed = <SEED>
}

Parallel {
  UseOmpThreads = Yes
}
